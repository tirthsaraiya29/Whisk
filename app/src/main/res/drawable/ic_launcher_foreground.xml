<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Ambient Drop Shadow behind Monogram -->
    <path
        android:pathData="M28,38 L39,73 L46,73 L54,56 L62,73 L69,73 L80,38 L73,38 L62,73 L54,56 L46,73 L35,38 Z"
        android:fillColor="#40000000" />

    <!-- Left Outer Facet (Pure Silver/White Gradient) -->
    <path android:pathData="M 28,35 L 39,70 L 46,70 L 35,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="35"
                android:endX="46"
                android:endY="70"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#C8D0E8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center-Left Facet (Metallic Silver Steel) -->
    <path android:pathData="M 39,70 L 54,46 L 54,53 L 46,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="70"
                android:endX="54"
                android:endY="46"
                android:type="linear">
                <item android:color="#B0C4DE" android:offset="0.0" />
                <item android:color="#E6ECF5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center-Right Facet (Vercel Cyan Gradient) -->
    <path android:pathData="M 54,46 L 69,70 L 62,70 L 54,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="46"
                android:endX="69"
                android:endY="70"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#00A3FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Outer Facet (Electric Blue Cyan Gradient) -->
    <path android:pathData="M 69,70 L 80,35 L 73,35 L 62,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="69"
                android:startY="70"
                android:endX="80"
                android:endY="35"
                android:type="linear">
                <item android:color="#00A3FF" android:offset="0.0" />
                <item android:color="#00F0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Apex Glowing Precision Diamond Notch -->
    <path
        android:pathData="M 54,34 L 58,38 L 54,42 L 50,38 Z"
        android:fillColor="#00F0FF" />

    <!-- Bottom Dynamic Whisk Energy Curve -->
    <path
        android:pathData="M 25,75 Q 54,83 83,75"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="25"
                android:startY="75"
                android:endX="83"
                android:endY="75"
                android:type="linear">
                <item android:color="#0000F0FF" android:offset="0.0" />
                <item android:color="#FF00F0FF" android:offset="0.5" />
                <item android:color="#00D71921" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Apex Flare Ring -->
    <path
        android:pathData="M 54,38 m -5,0 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0"
        android:fillColor="#3000F0FF" />
</vector>
